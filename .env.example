PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are accepted for existing Supabase projects.
# SUPABASE_ANON_KEY=
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
# Optional custom providers must implement Frankfurter v1's historical response shape.
FX_FALLBACK_URLS=[]

# Enable only AFTER database/rebuild.sql and the isolation checks pass.
COMPANY_REPORTING_ENABLED=false

# Enable after consultant invitation schema and access tests are applied.
CONSULTANT_INVITATIONS_ENABLED=false

# Optional server-only scheduled worker. Never expose this key in frontend variables.
SUPABASE_SERVICE_ROLE_KEY=
CONVERSION_RETRY_ENABLED=false
CONVERSION_RETRY_INTERVAL_MS=900000

# Optional ROI explanation; server-only, never use a VITE_ prefix.
GROQ_API_KEY=
GROQ_ROI_MODEL=openai/gpt-oss-20b
